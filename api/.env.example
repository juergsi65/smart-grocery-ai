# Nur fuer lokales Testen. In Produktion kommen die Cookidoo-Credentials
# pro Benutzer verschluesselt in die DB (spaeteres auth/users-Modul).
COOKIDOO_COUNTRY=at
COOKIDOO_COOKIE_DIR=/tmp/cookidoo_sessions
# Optional: Default-Login fuers schnelle Ausprobieren
# COOKIDOO_EMAIL=dein@cookidoo.at
# COOKIDOO_PASSWORD=deinpasswort
