{
  "name": "smart-grocery-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build": "npm run build:web",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply smart-grocery --local",
    "db:migrate:remote": "wrangler d1 migrations apply smart-grocery --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.158.0"
  }
}
